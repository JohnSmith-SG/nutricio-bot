# Переменные окружения бота. Значения — НЕ в этом файле и не в git.
# Либо сам ключ (локальный запуск), либо путь к файлу с ключом (*_FILE, на сервере).

BOT_TOKEN=            # токен Telegram-бота от @BotFather   (или BOT_TOKEN_FILE=/path/to/bot.token)
PROXYAPI_KEY=         # ключ ProxyAPI для нейросети           (или PROXYAPI_KEY_FILE=...)
YOUTUBE_API_KEY=      # ключ YouTube Data API v3 (видео)      (или YOUTUBE_API_KEY_FILE=...)
NUTRICIO_MODEL=openai/gpt-4o-mini   # модель нейросети (необязательно)
